# Bind to 0.0.0.0 inside the OpenShift container; use HTTPS on the external Route.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Prefer SITES_CONFIG_FILE in production (mounted Secret).
SITES_CONFIG_FILE=./examples/sites.example.json
# ADMIN_TOKEN is separate from all WordPress/site tokens; generate 32+ random bytes.
ADMIN_TOKEN=
# Provider secrets (never put these in WordPress or in a public repo).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional defaults; each tenant can specify its own model/provider.
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Only these hosts may appear in inbound requests when provided.
# For OpenShift set to e.g. mcp.example.com (and your upstream service name if needed)
ALLOWED_HOSTS=127.0.0.1,localhost
# Allowed browser Origins; browser-to-server direct access is off by default.
ALLOWED_ORIGINS=
MAX_REQUEST_BYTES=32768
MAX_MESSAGES=20
MAX_MESSAGE_CHARS=6000
MAX_CONCURRENT=6
RATE_LIMIT_PER_MINUTE=30
PROVIDER_TIMEOUT_MS=45000
AGENT_TIMEOUT_MS=90000
# Admin-only coding agents disabled until explicitly enabled.
ENABLE_AGENT_JOBS=false
# Set to a pre-created read-only workspace volume for agent execution.
AGENT_WORKSPACE=/workspace
