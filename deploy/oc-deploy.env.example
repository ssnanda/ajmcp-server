# Optional. Copy to .env.local (ignored by Git) only to override the defaults below or to supply keys without being prompted.
OPENSHIFT_PROJECT=ajmcp
AJMCP_HOST=ajmcp.ncllcagents.com
CERT_MANAGER_CLUSTER_ISSUER=letsencrypt-ncllc
AJMCP_SITES_FILE=sites.json
OPENAI_API_KEY=''
ANTHROPIC_API_KEY=''
# Leave blank to have the deploy script generate/save a random admin token.
ADMIN_TOKEN=''
# Remote Ollama SSH tunnel (used only with --sync-ollama-ssh).
OLLAMA_SSH_HOST=''
OLLAMA_SSH_USER=''
OLLAMA_SSH_PORT=22
OLLAMA_SSH_PRIVATE_KEY_FILE=''
OLLAMA_SSH_KNOWN_HOSTS_FILE=''
